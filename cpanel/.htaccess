Options -Indexes
RewriteEngine On
RewriteRule ^api/pos-sync/?$ api/pos-sync.php [L,QSA]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(self)"
</IfModule>

<FilesMatch "^(index\.html|kasir-offline\.html|sw\.js|registerSW\.js)$">
  Header always set Cache-Control "no-store, max-age=0"
</FilesMatch>
